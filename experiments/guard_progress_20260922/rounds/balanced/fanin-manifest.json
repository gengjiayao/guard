  "source_diff": "diff --git a/src/point-to-point/model/rdma-hw.cc b/src/point-to-point/model/rdma-hw.cc\nindex 3681af4..e1e7de7 100644\n--- a/src/point-to-point/model/rdma-hw.cc\n+++ b/src/point-to-point/model/rdma-hw.cc\n@@ -6383,6 +6383,22 @@ void RdmaHw::RefreshGuardGrantsForReliability() {\n     ResetGuardReliabilityRefresh();\n }\n \n+uint32_t RdmaHw::GuardDistinctSenders() const {\n+    std::unordered_set<uint32_t> senders;\n+    for (auto *flow : m_rate_flow_ctl_set) senders.insert(flow->dip);\n+    return senders.size();\n+}\n+\n+uint32_t RdmaHw::GuardLegacyServiceWidth() const {\n+    if (m_guardSchedulingHorizonBdps == 0 || m_guardReceiverConcurrency == 0)\n+        return m_guardReceiverConcurrency;\n+    // A grant can wait behind work for other receivers at its sender.\n+    // Widen service with fan-in to provide alternative senders, while keeping\n+    // completion ordering for a small contending set or a single sender.\n+    return std::max<uint32_t>(m_guardReceiverConcurrency,\n+                             (GuardDistinctSenders() + 3) / 4);\n+}\n+\n bool RdmaHw::GuardHasCompetingSenders(uint64_t line_rate_bps) const {\n     // RxQP addresses are reversed: dip identifies the DATA sender. A single\n     // sending NIC already schedules its own messages; imposing receiver K=1\n@@ -6439,11 +6455,11 @@ void RdmaHw::RedistributeGuardRates(const char *set_change, uint32_t generation)\n     std::sort(concurrency_remaining.begin(), concurrency_remaining.end());\n     size_t concurrency_candidates = concurrency_remaining.size();\n     uint32_t effective_concurrency = ComputeGuardEffectiveElephantConcurrency(\n-        m_guardReceiverConcurrency, concurrency_candidates,\n+        GuardLegacyServiceWidth(), concurrency_candidates,\n         m_guardAdaptiveElephantConcurrency);\n     if (m_guardSizeClassElephantConcurrency) {\n         effective_concurrency = ComputeGuardSizeClassElephantConcurrency(\n-            m_guardReceiverConcurrency, concurrency_candidates,\n+            GuardLegacyServiceWidth(), concurrency_candidates,\n             concurrency_candidates > 0 ? concurrency_remaining[0] : 0,\n             concurrency_candidates > 1 ? concurrency_remaining[1] : 0, true);\n     }\n@@ -6523,10 +6539,11 @@ std::unordered_map<RdmaRxQueuePair*, uint64_t> RdmaHw::ComputeGuardBaseTargets(\n     size_t count = m_rate_flow_ctl_set.size();\n     if (count == 0) return targets;\n     uint64_t equal_share = line_rate_bps / count;\n+    const bool competing_senders = GuardDistinctSenders() > 1;\n     auto scheduling_remaining = [&](RdmaRxQueuePair *flow) -> uint64_t {\n         uint64_t remaining = flow->m_guard_flow_size > flow->ReceiverNextExpectedSeq\n             ? flow->m_guard_flow_size - flow->ReceiverNextExpectedSeq : 1;\n-        if (m_guardSchedulingHorizonBdps > 0) {\n+        if (m_guardSchedulingHorizonBdps > 0 && competing_senders) {\n             uint64_t bdp = flow->m_base_rtt_sec > 0\n                 ? flow->m_base_rtt_sec * line_rate_bps / 8.0 : 104000;\n             remaining = std::min<uint64_t>(remaining,\n@@ -6573,7 +6590,7 @@ std::unordered_map<RdmaRxQueuePair*, uint64_t> RdmaHw::ComputeGuardBaseTargets(\n                   return left->m_flow_id < right->m_flow_id;\n               });\n     uint32_t effective_concurrency = ComputeGuardEffectiveElephantConcurrency(\n-        m_guardReceiverConcurrency, concurrency_candidates.size(),\n+        GuardLegacyServiceWidth(), concurrency_candidates.size(),\n         m_guardAdaptiveElephantConcurrency);\n     if (m_guardSizeClassElephantConcurrency) {\n         uint64_t first = concurrency_candidates.size() > 0\n@@ -6591,7 +6608,7 @@ std::unordered_map<RdmaRxQueuePair*, uint64_t> RdmaHw::ComputeGuardBaseTargets(\n                             concurrency_candidates[1]->ReceiverNextExpectedSeq\n                       : 1) : 0;\n         effective_concurrency = ComputeGuardSizeClassElephantConcurrency(\n-            m_guardReceiverConcurrency, concurrency_candidates.size(), first, second, true);\n+            GuardLegacyServiceWidth(), concurrency_candidates.size(), first, second, true);\n     }\n     size_t service_count = std::min<size_t>(concurrency_candidates.size(),\n                                              effective_concurrency);\ndiff --git a/src/point-to-point/model/rdma-hw.h b/src/point-to-point/model/rdma-hw.h\nindex c5390f5..1cee032 100644\n--- a/src/point-to-point/model/rdma-hw.h\n+++ b/src/point-to-point/model/rdma-hw.h\n@@ -886,6 +886,8 @@ class RdmaHw : public Object {\n     void SyncHwRate(Ptr<RdmaQueuePair> qp, DataRate target_cc_rate);\n     bool UsesGuardTailBypass(Ptr<RdmaQueuePair> qp) const;\n     bool GuardHasCompetingSenders(uint64_t line_rate_bps) const;\n+    uint32_t GuardDistinctSenders() const;\n+    uint32_t GuardLegacyServiceWidth() const;\n     void MaybeSendGuardCapReport(Ptr<RdmaQueuePair> qp);\n     void HandleRccRequest(Ptr<RdmaRxQueuePair> qp, Ptr<Packet> p, CustomHeader &ch);\n     bool HandleRccRemove(Ptr<RdmaRxQueuePair> qp, GuardReleaseReason reason,\ndiff --git a/tests/guard_scheduling_horizon.cc b/tests/guard_scheduling_horizon.cc\nindex d22170f..c4a1d50 100644\n--- a/tests/guard_scheduling_horizon.cc\n+++ b/tests/guard_scheduling_horizon.cc\n@@ -59,6 +59,7 @@ int main() {\n     // Equal long flows remain equal despite very different attained service.\n     hw->m_guardMinShareFraction = 0;\n     for (unsigned i = 0; i < flows.size(); ++i) {\n+        flows[i]->dip = i + 1;\n         flows[i]->m_guard_flow_size = 2000 * bdp;\n         flows[i]->ReceiverNextExpectedSeq = i * bdp;\n     }\n"
}
