  "source_diff": "diff --git a/src/point-to-point/model/rdma-hw.cc b/src/point-to-point/model/rdma-hw.cc\nindex 691f823..2ed1d7d 100644\n--- a/src/point-to-point/model/rdma-hw.cc\n+++ b/src/point-to-point/model/rdma-hw.cc\n@@ -6444,6 +6444,9 @@ void RdmaHw::RedistributeGuardRates(const char *set_change, uint32_t generation)\n             }\n         }\n     }\n+    if (m_guardSchedulingHorizonBdps > 0 && GuardDistinctSenders() > 1 &&\n+        concurrency_remaining.size() != m_rate_flow_ctl_set.size())\n+        concurrency_remaining.clear();\n     std::sort(concurrency_remaining.begin(), concurrency_remaining.end());\n     size_t concurrency_candidates = concurrency_remaining.size();\n     uint32_t effective_concurrency = ComputeGuardEffectiveElephantConcurrency(\n@@ -6532,10 +6535,18 @@ std::unordered_map<RdmaRxQueuePair*, uint64_t> RdmaHw::ComputeGuardBaseTargets(\n     if (count == 0) return targets;\n     uint64_t equal_share = line_rate_bps / count;\n     const bool competing_senders = GuardDistinctSenders() > 1;\n+    bool long_cohort = m_guardSchedulingHorizonBdps > 0 && competing_senders;\n+    for (auto *flow : m_rate_flow_ctl_set) {\n+        uint64_t bdp = flow->m_base_rtt_sec > 0\n+            ? flow->m_base_rtt_sec * line_rate_bps / 8.0 : 104000;\n+        uint64_t remaining = flow->m_guard_flow_size > flow->ReceiverNextExpectedSeq\n+            ? flow->m_guard_flow_size - flow->ReceiverNextExpectedSeq : 1;\n+        if (remaining <= m_guardSchedulingHorizonBdps * bdp) long_cohort = false;\n+    }\n     auto scheduling_remaining = [&](RdmaRxQueuePair *flow) -> uint64_t {\n         uint64_t remaining = flow->m_guard_flow_size > flow->ReceiverNextExpectedSeq\n             ? flow->m_guard_flow_size - flow->ReceiverNextExpectedSeq : 1;\n-        if (m_guardSchedulingHorizonBdps > 0 && competing_senders) {\n+        if (long_cohort) {\n             uint64_t bdp = flow->m_base_rtt_sec > 0\n                 ? flow->m_base_rtt_sec * line_rate_bps / 8.0 : 104000;\n             remaining = std::min<uint64_t>(remaining,\n@@ -6557,6 +6568,11 @@ std::unordered_map<RdmaRxQueuePair*, uint64_t> RdmaHw::ComputeGuardBaseTargets(\n                 concurrency_candidates.push_back(flow);\n         }\n     }\n+    // A mixed priority cohort needs simultaneous service: a receiver cannot\n+    // assume its preferred sender is available while that sender serves other\n+    // destinations. Preserve the normal weighted allocator in that case.\n+    if (m_guardSchedulingHorizonBdps > 0 && competing_senders &&\n+        concurrency_candidates.size() != count) concurrency_candidates.clear();\n     std::sort(concurrency_candidates.begin(), concurrency_candidates.end(),\n               [this](RdmaRxQueuePair *left, RdmaRxQueuePair *right) {\n                   uint64_t left_remaining =\n"
