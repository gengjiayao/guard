  "source_diff": "diff --git a/src/point-to-point/model/rdma-hw.cc b/src/point-to-point/model/rdma-hw.cc\nindex 3681af4..691f823 100644\n--- a/src/point-to-point/model/rdma-hw.cc\n+++ b/src/point-to-point/model/rdma-hw.cc\n@@ -6383,6 +6383,12 @@ void RdmaHw::RefreshGuardGrantsForReliability() {\n     ResetGuardReliabilityRefresh();\n }\n \n+uint32_t RdmaHw::GuardDistinctSenders() const {\n+    std::unordered_set<uint32_t> senders;\n+    for (auto *flow : m_rate_flow_ctl_set) senders.insert(flow->dip);\n+    return senders.size();\n+}\n+\n bool RdmaHw::GuardHasCompetingSenders(uint64_t line_rate_bps) const {\n     // RxQP addresses are reversed: dip identifies the DATA sender. A single\n     // sending NIC already schedules its own messages; imposing receiver K=1\n@@ -6421,13 +6427,15 @@ void RdmaHw::RedistributeGuardRates(const char *set_change, uint32_t generation)\n         m_guardCapAwareReclaim\n             ? ComputeGuardCapAwareTargets(line_rate_bps)\n             : ComputeGuardBaseTargets(line_rate_bps);\n+    const double concurrency_min_bdps = m_guardSchedulingHorizonBdps > 0 && GuardDistinctSenders() == 1\n+        ? 1.0 : m_guardConcurrencyMinBdps;\n     std::vector<uint64_t> concurrency_remaining;\n     if (m_guardReceiverConcurrency > 0 && GuardHasCompetingSenders(line_rate_bps)) {\n         for (auto *flow : m_rate_flow_ctl_set) {\n             uint64_t bdp_bytes = flow->m_base_rtt_sec > 0\n                                      ? (uint64_t)(flow->m_base_rtt_sec * line_rate_bps / 8.0)\n                                      : 104000;\n-            if (flow->m_guard_flow_size > m_guardConcurrencyMinBdps * bdp_bytes &&\n+            if (flow->m_guard_flow_size > concurrency_min_bdps * bdp_bytes &&\n                 (m_guardSchedulingHorizonBdps == 0 ||\n                  flow->m_guard_flow_size <= m_guardSchedulingHorizonBdps * bdp_bytes)) {\n                 concurrency_remaining.push_back(\n@@ -6523,10 +6531,11 @@ std::unordered_map<RdmaRxQueuePair*, uint64_t> RdmaHw::ComputeGuardBaseTargets(\n     size_t count = m_rate_flow_ctl_set.size();\n     if (count == 0) return targets;\n     uint64_t equal_share = line_rate_bps / count;\n+    const bool competing_senders = GuardDistinctSenders() > 1;\n     auto scheduling_remaining = [&](RdmaRxQueuePair *flow) -> uint64_t {\n         uint64_t remaining = flow->m_guard_flow_size > flow->ReceiverNextExpectedSeq\n             ? flow->m_guard_flow_size - flow->ReceiverNextExpectedSeq : 1;\n-        if (m_guardSchedulingHorizonBdps > 0) {\n+        if (m_guardSchedulingHorizonBdps > 0 && competing_senders) {\n             uint64_t bdp = flow->m_base_rtt_sec > 0\n                 ? flow->m_base_rtt_sec * line_rate_bps / 8.0 : 104000;\n             remaining = std::min<uint64_t>(remaining,\n@@ -6534,13 +6543,15 @@ std::unordered_map<RdmaRxQueuePair*, uint64_t> RdmaHw::ComputeGuardBaseTargets(\n         }\n         return std::max<uint64_t>(remaining, m_mtu);\n     };\n+    const double concurrency_min_bdps = m_guardSchedulingHorizonBdps > 0 && !competing_senders\n+        ? 1.0 : m_guardConcurrencyMinBdps;\n     std::vector<RdmaRxQueuePair*> concurrency_candidates;\n     if (m_guardReceiverConcurrency > 0 && GuardHasCompetingSenders(line_rate_bps)) {\n         for (auto *flow : m_rate_flow_ctl_set) {\n             uint64_t bdp_bytes = flow->m_base_rtt_sec > 0\n                                      ? (uint64_t)(flow->m_base_rtt_sec * line_rate_bps / 8.0)\n                                      : 104000;\n-            if (flow->m_guard_flow_size > m_guardConcurrencyMinBdps * bdp_bytes &&\n+            if (flow->m_guard_flow_size > concurrency_min_bdps * bdp_bytes &&\n                 (m_guardSchedulingHorizonBdps == 0 ||\n                  flow->m_guard_flow_size <= m_guardSchedulingHorizonBdps * bdp_bytes))\n                 concurrency_candidates.push_back(flow);\ndiff --git a/src/point-to-point/model/rdma-hw.h b/src/point-to-point/model/rdma-hw.h\nindex c5390f5..a07d9c4 100644\n--- a/src/point-to-point/model/rdma-hw.h\n+++ b/src/point-to-point/model/rdma-hw.h\n@@ -886,6 +886,7 @@ class RdmaHw : public Object {\n     void SyncHwRate(Ptr<RdmaQueuePair> qp, DataRate target_cc_rate);\n     bool UsesGuardTailBypass(Ptr<RdmaQueuePair> qp) const;\n     bool GuardHasCompetingSenders(uint64_t line_rate_bps) const;\n+    uint32_t GuardDistinctSenders() const;\n     void MaybeSendGuardCapReport(Ptr<RdmaQueuePair> qp);\n     void HandleRccRequest(Ptr<RdmaRxQueuePair> qp, Ptr<Packet> p, CustomHeader &ch);\n     bool HandleRccRemove(Ptr<RdmaRxQueuePair> qp, GuardReleaseReason reason,\ndiff --git a/tests/guard_scheduling_horizon.cc b/tests/guard_scheduling_horizon.cc\nindex d22170f..c4a1d50 100644\n--- a/tests/guard_scheduling_horizon.cc\n+++ b/tests/guard_scheduling_horizon.cc\n@@ -59,6 +59,7 @@ int main() {\n     // Equal long flows remain equal despite very different attained service.\n     hw->m_guardMinShareFraction = 0;\n     for (unsigned i = 0; i < flows.size(); ++i) {\n+        flows[i]->dip = i + 1;\n         flows[i]->m_guard_flow_size = 2000 * bdp;\n         flows[i]->ReceiverNextExpectedSeq = i * bdp;\n     }\n"
