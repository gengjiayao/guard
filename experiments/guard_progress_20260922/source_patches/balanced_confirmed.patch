new file mode 100644
index 0000000..5b6df19
--- /dev/null
+++ b/tests/guard_scheduling_horizon.cc
@@ -0,0 +1,96 @@
+// Behavioral checks against the actual receiver allocator, not a model copy.
+#include "ns3/rdma-hw.h"
+#include <algorithm>
+#include <cassert>
+#include <iostream>
+#include <random>
+
+using namespace ns3;
+
+int main() {
+    Ptr<RdmaHw> hw = CreateObject<RdmaHw>();
+    const uint64_t capacity = 100000000000ULL;
+    const uint64_t bdp = 100000;
+    hw->m_guardReceiverConcurrency = 1;
+    hw->m_guardConcurrencyMinBdps = 1;
+    hw->m_guardSchedulingHorizonBdps = 128;
+    hw->m_guardMinShareFraction = .25;
+    hw->m_guardAdaptiveElephantConcurrency = false;
+    hw->m_guardSizeClassElephantConcurrency = false;
+    hw->m_guardRemainingAware = true;
+    hw->m_guardRemainingExponent = 1;
+    hw->m_mtu = 1000;
+    hw->m_minRate = DataRate(100000000);
+    std::mt19937 rng(7249);
+    std::vector<Ptr<RdmaRxQueuePair> > flows;
+    for (unsigned trial = 0; trial < 1000; ++trial) {
+        hw->m_rate_flow_ctl_set.clear();
+        flows.clear();
+        unsigned count = 2 + rng() % 30;
+        for (unsigned i = 0; i < count; ++i) {
+            Ptr<RdmaRxQueuePair> f = Create<RdmaRxQueuePair>();
+            f->m_base_rtt_sec = .000008;
+            f->dip = trial % 2 ? i + 1 : 1;
+            f->m_flow_id = i;
+            f->m_guard_flow_size = (2 + rng() % 2000) * bdp;
+            f->ReceiverNextExpectedSeq = rng() % f->m_guard_flow_size;
+            flows.push_back(f);
+            hw->m_rate_flow_ctl_set.insert(PeekPointer(f));
+        }
+        hw->m_guardMinShareFraction = (trial % 5) * .25;
+        auto targets = hw->ComputeGuardBaseTargets(capacity);
+        uint64_t sum = 0;
+        uint64_t floor = hw->m_guardMinShareFraction * (capacity / count);
+        for (auto &entry : targets) {
+            assert(entry.second >= floor);
+            sum += entry.second;
+        }
+        assert(sum <= capacity);
+        assert(capacity - sum <= count);
+        std::reverse(flows.begin(), flows.end());
+        hw->m_rate_flow_ctl_set.clear();
+        for (auto f : flows) hw->m_rate_flow_ctl_set.insert(PeekPointer(f));
+        auto reversed = hw->ComputeGuardBaseTargets(capacity);
+        for (auto &entry : targets) {
+            // Floating-point summation may move a rounded target by one bit/s.
+            assert(std::abs((int64_t)entry.second - (int64_t)reversed[entry.first]) <= 1);
+        }
+    }
+    // Equal long flows remain equal despite very different attained service.
+    hw->m_guardMinShareFraction = 0;
+    for (unsigned i = 0; i < flows.size(); ++i) {
+        flows[i]->dip = i + 1;
+        flows[i]->m_guard_flow_size = 2000 * bdp;
+        flows[i]->ReceiverNextExpectedSeq = i * bdp;
+    }
+    auto equal = hw->ComputeGuardBaseTargets(capacity);
+    for (auto &entry : equal) assert(entry.second == capacity / flows.size());
+    // A single NIC keeps its remaining-size scheduler for long messages.
+    for (auto f : flows) f->dip = 1;
+    auto single = hw->ComputeGuardBaseTargets(capacity);
+    hw->m_guardSchedulingHorizonBdps = 0;
+    auto legacy = hw->ComputeGuardBaseTargets(capacity);
+    for (auto &entry : single) assert(entry.second == legacy[entry.first]);
+    hw->m_guardSchedulingHorizonBdps = 128;
+    hw->m_guardConcurrencyMinBdps = 12;
+    hw->m_rate_flow_ctl_set.clear();
+    flows.resize(2);
+    for (unsigned i = 0; i < 2; ++i) {
+        flows[i]->dip = i + 1;
+        flows[i]->m_guard_flow_size = (6 + 2*i) * 1048576;
+        flows[i]->ReceiverNextExpectedSeq = 0;
+        flows[i]->m_base_rtt_sec = i ? .000008 : .000002;
+        hw->m_rate_flow_ctl_set.insert(PeekPointer(flows[i]));
+    }
+    auto different_paths = hw->ComputeGuardBaseTargets(capacity);
+    assert(different_paths[PeekPointer(flows[0])] > .99 * capacity);
+    // Mixing a short class into receiver fan-in restores weighted service.
+    flows[0]->m_guard_flow_size = 200000;
+    auto mixed = hw->ComputeGuardBaseTargets(capacity);
+    hw->m_guardReceiverConcurrency = 0;
+    auto weighted = hw->ComputeGuardBaseTargets(capacity);
+    for (auto &entry : mixed) assert(entry.second == weighted[entry.first]);
+    hw->m_rate_flow_ctl_set.clear();
+    Simulator::Destroy();
+    std::cout << "PASS: 1000 allocator states; capacity, floor, order, equality, sender scope, mixed classes, unequal RTTs\n";
+}
diff --git a/tests/test_output_reservation.py b/tests/test_output_reservation.py
new file mode 100644
index 0000000..6b31233
--- /dev/null
+++ b/tests/test_output_reservation.py
@@ -0,0 +1,27 @@
+import importlib.util
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+import tempfile
+import unittest
+
+spec = importlib.util.spec_from_file_location('guard_driver', Path(__file__).resolve().parents[1]/'run.py')
+driver = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(driver)
+
+
+class OutputReservationTest(unittest.TestCase):
+    def test_concurrent_identical_ids_do_not_overwrite(self):
+        with tempfile.TemporaryDirectory() as parent:
+            existing = Path(parent)/'42'
+            existing.mkdir()
+            marker = existing/'marker'
+            marker.write_text('preserve')
+            with ThreadPoolExecutor(max_workers=16) as pool:
+                outputs = list(pool.map(lambda _: driver.reserve_output_directory(parent, 42), range(64)))
+            self.assertEqual(len(set(path for _, path in outputs)), 64)
+            self.assertEqual(marker.read_text(), 'preserve')
+            self.assertTrue(all(Path(path).is_dir() for _, path in outputs))
+
+
+if __name__ == '__main__':
+    unittest.main()
