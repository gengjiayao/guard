+uint64_t RdmaHw::GuardSchedulingBdp(uint64_t line_rate_bps) const {
+    // One receiver service horizon applies to every peer, including peers
+    // with a shorter path. It must not change a message's size class merely
+    // because that sender is in the same rack.
+    uint64_t bdp = 1;
+    for (auto *flow : m_rate_flow_ctl_set) {
+        bdp = std::max<uint64_t>(bdp, flow->m_base_rtt_sec > 0
+            ? flow->m_base_rtt_sec * line_rate_bps / 8.0 : 104000);
+    }
+    return bdp;
+}
+
+uint32_t RdmaHw::GuardDistinctSenders() const {
+    std::unordered_set<uint32_t> senders;
+    for (auto *flow : m_rate_flow_ctl_set) senders.insert(flow->dip);
+    return senders.size();
+}
+
+bool RdmaHw::UsesGuardSingleSenderSharedCap(uint64_t line_rate_bps) const {
+    if (m_guardSingleSenderSharedCapBdps == 0 || GuardDistinctSenders() != 1)
+        return false;
+    const uint64_t bdp = GuardSchedulingBdp(line_rate_bps);
+    for (auto *flow : m_rate_flow_ctl_set) {
+        if (flow->m_guard_flow_size <= m_guardSingleSenderSharedCapBdps * bdp)
+            return false;
+    }
+    return true;
+}
+
+bool RdmaHw::GuardHasCompetingSenders(uint64_t line_rate_bps) const {
+    // RxQP addresses are reversed: dip identifies the DATA sender. A single
+    // sending NIC already schedules its own messages; imposing receiver K=1
+    // on that NIC's separate QPs duplicates ordering and can leave its grant
+    // unused. Apply the receiver concurrency limit to actual sender fan-in.
+    if (m_rate_flow_ctl_set.empty()) return false;
+    if (UsesGuardSingleSenderSharedCap(line_rate_bps)) return false;
+    if (m_guardSingleSenderOrder && GuardDistinctSenders() == 1) return true;
+    const uint64_t receiver_bdp = GuardSchedulingBdp(line_rate_bps);
+    // With a bounded scheduling horizon, short messages from one NIC can
+    // share its grant in completion order. Long transfers retain the old
+    // sender-scope protection against redundant receiver serialization.
+    if (m_guardSchedulingHorizonBdps > 0) {
+        for (auto *flow : m_rate_flow_ctl_set) {
+            uint64_t bdp = receiver_bdp;
+            if (flow->m_guard_flow_size <= m_guardSchedulingHorizonBdps * bdp)
+                return true;
+        }
+    }
+    uint32_t first_sender = (*m_rate_flow_ctl_set.begin())->dip;
+    for (auto *flow : m_rate_flow_ctl_set) {
+        if (flow->dip != first_sender) return true;
+    }
+    return false;
+}
