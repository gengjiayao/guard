+bool RdmaEgressQueue::GuardAckRescueDue(Ptr<RdmaQueuePair> qp, uint32_t mtu, uint32_t ack_packets) {
+    if (!qp->m_guard_sender_srpt || qp->irn.m_enabled || qp->GetBytesLeft() == 0 ||
