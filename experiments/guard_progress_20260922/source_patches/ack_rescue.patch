+#include "ns3/rdma-hw.h"
+#include <algorithm>
+#include <cassert>
+#include <iostream>
+#include <memory>
+#include <random>
+using namespace ns3;
+int main() {
+    std::vector<std::unique_ptr<RdmaHw::HomaFlow>> owned;
+    std::vector<RdmaHw::HomaFlow*> batch;
+    for (unsigned i=0;i<64;++i) {
+        owned.emplace_back(new RdmaHw::HomaFlow());
+        auto* f=owned.back().get();f->message_id=i/2;
+        f->rx_qp=CreateObject<RdmaRxQueuePair>();
+        f->rx_qp->sip=i;f->rx_qp->dip=100;f->rx_qp->sport=200;f->rx_qp->dport=300;f->pg=0;
+        f->last_progress_time=NanoSeconds(i+1);f->granted_offset_sent=1000+i;
+        batch.push_back(f);
+    }
+    auto expected=batch;std::mt19937 rng(301);
+    for (unsigned n=0;n<1000;++n) {
+        std::shuffle(batch.begin(),batch.end(),rng);
+        RdmaHw::HomaScheduler::SortResendBatch(batch);
+        assert(batch==expected);
+        for (unsigned i=0;i<64;++i) {
+            assert(batch[i]->last_progress_time==NanoSeconds(i+1));
+            assert(batch[i]->granted_offset_sent==1000+i);
+        }
+    }
+    std::cout<<"PASS: actual RESEND batch sorter is independent of 1000 input permutations; wire identity breaks ties; timer and authorization state preserved\n";
+}
