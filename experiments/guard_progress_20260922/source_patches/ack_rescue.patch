+#include "ns3/rdma-hw.h"
+#include <cassert>
+#include <iostream>
+using namespace ns3;
+static Ptr<RdmaQueuePair> Make(uint64_t size) {
+    auto q=CreateObject<RdmaQueuePair>(3,Ipv4Address(1),Ipv4Address(2),100,101);
+    q->SetSize(size);q->SetWin(100000);q->m_max_rate=DataRate(100000000000ULL);
+    return q;
+}
+int main() {
+    auto g=CreateObject<RdmaQueuePairGroup>();auto q=Make(25000000);g->AddQp(q);
+    auto rate=[&](double bdp){return RdmaHw::ComputeGuardStartupRateBps(q,g,bdp,100000000);};
+    assert(rate(128)==100000000000ULL);
+    auto p=Make(25000000);g->AddQp(p);assert(rate(128)==50000000000ULL);
+    auto shortq=Make(12800000);g->AddQp(shortq);assert(rate(128)==50000000000ULL);
+    auto waitingAck=Make(25000000);waitingAck->snd_nxt=waitingAck->m_size;g->AddQp(waitingAck);
+    assert(rate(128)==50000000000ULL);
+    p->snd_una=p->m_size;assert(rate(128)==100000000000ULL);
+    assert(rate(0)==100000000000ULL);
+    p->snd_una=0;q->m_size=12800000;assert(rate(128)==100000000000ULL);
+    q->m_size=25000000;
+    assert(RdmaHw::ComputeGuardStartupRateBps(q,g,128,60000000000ULL)==60000000000ULL);
+    assert(RdmaHw::ComputeGuardStartupRateBps(q,g,128,200000000000ULL)==100000000000ULL);
+    auto elsewhere=Make(25000000);elsewhere->dip=Ipv4Address(3);g->AddQp(elsewhere);
+    assert(RdmaHw::ComputeGuardStartupRateBps(q,g,128,100000000,false)==33333333333ULL);
+    assert(RdmaHw::ComputeGuardStartupRateBps(q,g,128,100000000,true)==50000000000ULL);
+    p->snd_nxt=p->m_size;
+    assert(RdmaHw::ComputeGuardStartupRateBps(q,g,128,100000000,true)==100000000000ULL);
+    std::cout<<"PASS: same-peer isolation;  active demand, completion, ACK-only, threshold, disabled, min/max bounds\n";
+}
