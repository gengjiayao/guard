+#include <cassert>
+#include <iostream>
+using namespace ns3;
+static void Expire() { assert(false && "test must finish before existing recovery expires"); }
+static void Arm(Ptr<RdmaQueuePair> q) {
+ if(q->m_retransmit.IsRunning())q->m_retransmit.Cancel();
+ q->m_retransmit=Simulator::Schedule(MilliSeconds(4),&Expire);
+}
+static Ptr<Packet> Send(Ptr<RdmaQueuePair> q) {
+ q->snd_nxt+=1000;Arm(q);
+ if(q->m_flow_id==0 || q->GetOnTheFly()>=8000) {
+  q->snd_una=q->snd_nxt;q->m_retransmit.Cancel();
+ }
+ return Create<Packet>(1000);
+}
+static Ptr<RdmaEgressQueue> Build() {
+ IntHeader::mode=0;Settings::guard_sender_ack_rescue=true;
+ Settings::guard_sender_fair_cursor=true;Settings::guard_sender_service_budget=false;
+ Settings::guard_sender_ack_batch=false;Settings::guard_sender_ack_batch_packets=8;
+ Settings::guard_sender_ack_rescue_episodes=Settings::guard_sender_ack_rescue_packets=0;
+ auto e=CreateObject<RdmaEgressQueue>();e->m_qpGrp=CreateObject<RdmaQueuePairGroup>();e->m_rdmaGetNxtPkt=MakeCallback(&Send);
+ for(unsigned i=0;i<3;++i) {
+  auto q=CreateObject<RdmaQueuePair>(3,Ipv4Address(1),Ipv4Address(2),100+i,200);
+  q->SetSize((i+1)*10000000);q->m_flow_id=i;q->m_guard_sender_srpt=true;
+  q->m_guard_srpt_quantum_packets=64;q->m_win=0;q->m_nextAvail=NanoSeconds(0);q->SetTimeout(MilliSeconds(4));
+  e->m_qpGrp->AddQp(q);
+ }
+ auto q=e->m_qpGrp->Get(1);q->snd_nxt=5000;q->snd_una=1000;Arm(q);return e;
+}
+static bool paused[8]={false};
+static void Selected(Ptr<RdmaEgressQueue> e,int expected) {
+ int next=e->GetNextQindex(paused);assert(next==expected);e->DequeueQindex(next);
+}
+static void Before(Ptr<RdmaEgressQueue> e) {
+ assert(!RdmaEgressQueue::GuardAckRescueDue(e->m_qpGrp->Get(1),1000,8));Selected(e,0);
+ assert(Settings::guard_sender_ack_rescue_episodes==0);
+}
+static void Batch(Ptr<RdmaEgressQueue> e) {
+ assert(RdmaEgressQueue::GuardAckRescueDue(e->m_qpGrp->Get(1),1000,8));
+ for(unsigned i=0;i<4;++i) {
+  Selected(e,1);
+  // Sending restarts the recovery timer, but the latched batch must continue.
+  assert(!RdmaEgressQueue::GuardAckRescueDue(e->m_qpGrp->Get(1),1000,8));
+ }
+ assert(e->m_guardAckRescueIndex==-1);Selected(e,0);
+ assert(Settings::guard_sender_ack_rescue_episodes==1&&Settings::guard_sender_ack_rescue_packets==4);
+}
+static void Exclude(Ptr<RdmaEgressQueue> e,unsigned cause) {
+ Selected(e,1);Selected(e,1);auto q=e->m_qpGrp->Get(1);
+ if(cause==0){q->m_pg=4;paused[4]=true;}
+ if(cause==1)q->m_nextAvail=Simulator::Now()+NanoSeconds(1);
+ if(cause==2){q->m_win=1000;}
+ if(cause==3)e->m_qpGrp->SetQpFinished(1);
+ if(cause==4)q->m_flow_id=9001;
+ if(cause==5)q->m_retransmit.Cancel();
+ if(cause==6)q->snd_una=q->snd_nxt;
+ if(cause==7)q->irn.m_enabled=true;
+ Selected(e,0);
+ if(cause<3){paused[4]=false;q->m_nextAvail=Simulator::Now();q->m_win=0;Selected(e,1);}
+ paused[4]=false;
+}
+static void Ineligible(Ptr<RdmaEgressQueue> e) {
+ auto q=e->m_qpGrp->Get(1);
+ q->snd_nxt=q->snd_una;assert(!RdmaEgressQueue::GuardAckRescueDue(q,1000,8));
+ q->snd_nxt=q->snd_una+8000;assert(!RdmaEgressQueue::GuardAckRescueDue(q,1000,8));
+ q->snd_nxt=q->snd_una+4000;q->irn.m_enabled=true;assert(!RdmaEgressQueue::GuardAckRescueDue(q,1000,8));
+ q->irn.m_enabled=false;q->m_retransmit.Cancel();assert(!RdmaEgressQueue::GuardAckRescueDue(q,1000,8));
+}
+static void Earliest(Ptr<RdmaEgressQueue> e){Selected(e,2);}
+int main() {
+ {auto e=Build();Simulator::Schedule(NanoSeconds(1999999),&Before,e);Simulator::Schedule(MilliSeconds(2),&Batch,e);
+  Simulator::Stop(MilliSeconds(2));Simulator::Run();Simulator::Destroy();}
+ for(unsigned cause=0;cause<8;++cause){auto e=Build();Simulator::Schedule(MilliSeconds(2),&Exclude,e,cause);
+  Simulator::Stop(MilliSeconds(2));Simulator::Run();Simulator::Destroy();}
+ {auto e=Build();Simulator::Schedule(MilliSeconds(2),&Ineligible,e);
+  Simulator::Stop(MilliSeconds(2));Simulator::Run();Simulator::Destroy();}
+ {auto e=Build();auto q=e->m_qpGrp->Get(2);q->snd_nxt=4000;q->snd_una=0;Arm(q);
+  Simulator::Schedule(MilliSeconds(1),&Arm,e->m_qpGrp->Get(1));Simulator::Schedule(MilliSeconds(3),&Earliest,e);
+  Simulator::Stop(MilliSeconds(3));Simulator::Run();Simulator::Destroy();}
+ std::cout<<"PASS: actual scheduler is neutral before half-RTO, rescues only partial batches, completes latch across timer resets, honors eight exclusions and earliest deadline\n";
+}
diff --git a/tests/guard_fair_cursor.cc b/tests/guard_fair_cursor.cc
new file mode 100644
index 0000000..7967eac
--- /dev/null
+++ b/tests/guard_fair_cursor.cc
@@ -0,0 +1,44 @@
+#include "ns3/qbb-net-device.h"
+#include "ns3/settings.h"
+#include <cassert>
+#include <iostream>
+#include <array>
+using namespace ns3;
+static Ptr<Packet> Send(Ptr<RdmaQueuePair> q) {
+    q->snd_nxt+=1000;q->snd_una=q->snd_nxt;return Create<Packet>(1000);
+}
+static std::array<unsigned,4> Run(bool enabled, unsigned blocked=0) {
+    IntHeader::mode=0;Settings::guard_sender_fair_cursor=enabled;
+    auto e=CreateObject<RdmaEgressQueue>();
+    e->m_qpGrp=CreateObject<RdmaQueuePairGroup>();e->m_rdmaGetNxtPkt=MakeCallback(&Send);
+    bool paused[8]={false};
+    for (unsigned i=0;i<4;++i) {
+        auto q=CreateObject<RdmaQueuePair>(3,Ipv4Address(1),Ipv4Address(2),100+i,200);
+        q->SetSize(i==0?10000000:100000000);
+        q->m_flow_id=i;q->m_guard_sender_srpt=true;q->m_guard_srpt_quantum_packets=64;
+        q->m_win=0;q->m_nextAvail=NanoSeconds(0);
+        if (i==1) {
+            if (blocked==1) {q->m_pg=4;paused[4]=true;}
+            if (blocked==2) q->m_nextAvail=NanoSeconds(1);
+            if (blocked==3) {q->m_win=1000;q->snd_nxt=1000;}
+        }
+        e->m_qpGrp->AddQp(q);
+        if (i==1 && blocked==4) e->m_qpGrp->SetQpFinished(i);
+    }
+    std::array<unsigned,4> count={{0,0,0,0}};
+    for (unsigned i=0;i<650;++i) {
+        int next=e->GetNextQindex(paused);assert(next>=0&&next<4);
+        ++count[next];e->DequeueQindex(next);
+    }
+    return count;
+}
+int main() {
+    auto legacy=Run(false),fair=Run(true);
+    assert((legacy==std::array<unsigned,4>{{640,10,0,0}}));
+    assert((fair==std::array<unsigned,4>{{640,4,3,3}}));
+    for (unsigned blocked=1;blocked<=4;++blocked) {
+        auto count=Run(true,blocked);
+        assert((count==std::array<unsigned,4>{{640,0,5,5}}));
+    }
+    std::cout<<"PASS: actual scheduler legacy640/10/0/0 becomes640/4/3/3; shortest-flow quantum retained; paused, pacing-blocked, window-blocked and finished flows excluded\n";
+}
