 NS_LOG_COMPONENT_DEFINE("GENERIC_SIMULATION");
 
+// Optional observation of actual host packet serialization. Preallocate before
+// flows start; counting does not create packets or schedule simulator events.
+struct GuardWireCounter {
+    uint64_t packets;
+    uint64_t bytes;
+    GuardWireCounter() : packets(0), bytes(0) {}
+};
+std::vector<std::array<GuardWireCounter, 256> > guard_wire_counters;
+void GuardObserveHostTx(uint32_t node_id, Ptr<const Packet> packet) {
+    CustomHeader ch(CustomHeader::L2_Header | CustomHeader::L3_Header |
+                    CustomHeader::L4_Header);
+    packet->PeekHeader(ch);
+    NS_ABORT_MSG_IF(node_id >= guard_wire_counters.size(), "wire counter node out of range");
+    GuardWireCounter &counter = guard_wire_counters[node_id][ch.l3Prot];
+    counter.packets++;
+    counter.bytes += packet->GetSize();
+}
