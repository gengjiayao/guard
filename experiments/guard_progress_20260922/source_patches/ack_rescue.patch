diff --git a/tests/guard_ack_batch.cc b/tests/guard_ack_batch.cc
new file mode 100644
index 0000000..fc2269f
--- /dev/null
+++ b/tests/guard_ack_batch.cc
@@ -0,0 +1,52 @@
+#include "ns3/qbb-net-device.h"
+#include "ns3/settings.h"
+#include <array>
+#include <cassert>
+#include <iostream>
+using namespace ns3;
+static Ptr<Packet> Send(Ptr<RdmaQueuePair> q) {
+    q->snd_nxt+=1000;q->snd_una=q->snd_nxt;return Create<Packet>(1000);
+}
+static Ptr<RdmaEgressQueue> Build(bool batch) {
+    IntHeader::mode=0;Settings::guard_sender_fair_cursor=true;
+    Settings::guard_sender_ack_batch=batch;Settings::guard_sender_ack_batch_packets=8;
+    auto e=CreateObject<RdmaEgressQueue>();e->m_qpGrp=CreateObject<RdmaQueuePairGroup>();
+    e->m_rdmaGetNxtPkt=MakeCallback(&Send);
+    for (unsigned i=0;i<4;++i) {
+        auto q=CreateObject<RdmaQueuePair>(3,Ipv4Address(1),Ipv4Address(2),100+i,200);
+        q->SetSize(i==0?10000000:100000000);q->m_flow_id=i;
+        q->m_guard_sender_srpt=true;q->m_guard_srpt_quantum_packets=64;
+        q->m_win=0;q->m_nextAvail=NanoSeconds(0);e->m_qpGrp->AddQp(q);
+    }
+    return e;
+}
+static std::array<unsigned,4> Serve(Ptr<RdmaEgressQueue> e,unsigned packets,bool* paused) {
+    std::array<unsigned,4> counts={{0,0,0,0}};
+    for (unsigned n=0;n<packets;++n) {
+        int next=e->GetNextQindex(paused);assert(next>=0&&next<4);
+        ++counts[next];e->DequeueQindex(next);
+    }
+    return counts;
+}
+int main() {
+    bool paused[8]={false};
+    auto legacy=Build(false);assert((Serve(legacy,650,paused)==std::array<unsigned,4>{{640,4,3,3}}));
+    auto batch=Build(true);assert((Serve(batch,1560,paused)==std::array<unsigned,4>{{1536,8,8,8}}));
+    // Four additional packets complete an already-started eight-packet ACK batch.
+    auto partial=Build(true);auto q=partial->m_qpGrp->Get(1);q->snd_nxt=5000;q->snd_una=1000;
+    assert((Serve(partial,260,paused)==std::array<unsigned,4>{{256,4,0,0}}));
+    assert(partial->m_guardSrptBatchIndex==-1);
+    assert((Serve(partial,65,paused)==std::array<unsigned,4>{{64,0,1,0}}));
+    // A reserved recipient must never stall eligible competitors.
+    for (unsigned cause=0;cause<5;++cause) {
+        auto blocked=Build(true);Serve(blocked,130,paused);q=blocked->m_qpGrp->Get(1);
+        if(cause==0) {q->m_pg=4;paused[4]=true;}
+        if(cause==1) q->m_nextAvail=NanoSeconds(1);
+        if(cause==2) {q->m_win=1000;q->snd_nxt=q->snd_una+1000;}
+        if(cause==3) blocked->m_qpGrp->SetQpFinished(1);
+        if(cause==4) q->m_flow_id=9001;
+        assert((Serve(blocked,65,paused)==std::array<unsigned,4>{{64,0,1,0}}));
+        paused[4]=false;
+    }
+    std::cout<<"PASS: actual scheduler preserves64:1 service, completes existing ACK batch, rotates all ready peers, and releases blocked/finished/reused recipients\n";
+}
diff --git a/tests/guard_ack_deadline.cc b/tests/guard_ack_deadline.cc
new file mode 100644
index 0000000..8299590
--- /dev/null
+++ b/tests/guard_ack_deadline.cc
@@ -0,0 +1,37 @@
+#include "ns3/rdma-hw.h"
+#include "ns3/simulator.h"
+#include <cassert>
+#include <iostream>
+using namespace ns3;
+static unsigned fired = 0;
+static void Fire() { ++fired; }
+int main() {
+    auto q = CreateObject<RdmaRxQueuePair>();
+    auto other = CreateObject<RdmaRxQueuePair>();
+    q->m_guard_pending_ack_packet = Create<Packet>(1000);
+    q->m_guard_delayed_ack_event = Simulator::Schedule(NanoSeconds(10), &Fire);
+    other->m_guard_delayed_ack_event = Simulator::Schedule(NanoSeconds(20), &Fire);
+    q->ReceiverNextExpectedSeq = 3000;
+    q->m_guard_last_ack_seq = 1000;
+    assert(RdmaHw::CancelGuardDelayedAck(q));
+    assert(q->m_guard_pending_ack_packet == NULL);
+    assert(!RdmaHw::CancelGuardDelayedAck(q));
+    assert(q->ReceiverNextExpectedSeq == 3000 && q->m_guard_last_ack_seq == 1000);
+    assert(other->m_guard_delayed_ack_event.IsRunning());
+    Simulator::Run();
+    assert(fired == 1);
+    Simulator::Destroy();
+    auto hw = CreateObject<RdmaHw>();
+    // A completed message and an already-acknowledged batch never emit a
+    // stale timer ACK, even if an old callback is invoked defensively.
+    q->m_guard_pending_ack_packet = Create<Packet>(1000);
+    q->m_guard_flow_size = q->ReceiverNextExpectedSeq;
+    hw->SendGuardDelayedAck(q);
+    assert(hw->m_guardDelayedAcksSent == 0 && q->m_guard_pending_ack_packet == NULL);
+    q->m_guard_pending_ack_packet = Create<Packet>(1000);
+    q->m_guard_flow_size += 1000;
+    q->m_guard_last_ack_seq = q->ReceiverNextExpectedSeq;
+    hw->SendGuardDelayedAck(q);
+    assert(hw->m_guardDelayedAcksSent == 0 && q->m_guard_pending_ack_packet == NULL);
+    std::cout << "PASS: cancellation suppresses stale event, preserves progress and other flow timer; completed/acknowledged batches cannot emit stale ACKs\n";
+}
