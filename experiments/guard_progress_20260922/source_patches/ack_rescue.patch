+bool RdmaHw::ApplyGuardStartupPathFeedback(Ptr<RdmaQueuePair> qp, uint32_t fabric_hops) {
+    if (!qp->m_guard_startup_path_pending) return false;
+    qp->m_guard_startup_path_pending = false;
+    if (fabric_hops != 0) return false;
+    // The first ACK confirms that receiver-hop removal leaves no fabric
+    // controller. An initial estimate would otherwise never be refreshed.
+    // The caller still composes this rate with the receiver grant.
+    qp->hp.m_curRate = qp->m_max_rate;
+    for (uint32_t i = 0; i < IntHeader::maxHop; ++i)
+        qp->hp.hopState[i].Rc = qp->m_max_rate;
+    return true;
+}
+
+uint64_t RdmaHw::ComputeGuardRecoveryIncrementBps(
+    uint64_t base_increment_bps, uint64_t elapsed_ns,
+    uint64_t base_rtt_ns, uint32_t maximum_rtts) {
+    if (maximum_rtts <= 1 || base_rtt_ns == 0 || elapsed_ns <= base_rtt_ns)
+        return base_increment_bps;
+    __uint128_t scaled = static_cast<__uint128_t>(base_increment_bps) * elapsed_ns / base_rtt_ns;
+    __uint128_t bound = static_cast<__uint128_t>(base_increment_bps) * maximum_rtts;
+    return static_cast<uint64_t>(std::min<__uint128_t>(
+        std::numeric_limits<uint64_t>::max(), std::min(scaled, bound)));
+}
+
+uint64_t RdmaHw::ComputeGuardStartupRateBps(
+    Ptr<RdmaQueuePair> qp, Ptr<RdmaQueuePairGroup> group,
+    double minimum_bdps, uint64_t minimum_rate_bps, bool same_peer_only) {
+    uint64_t line = qp->m_max_rate.GetBitRate();
+    if (minimum_bdps <= 0 || qp->m_win == 0 ||
+        qp->m_size <= minimum_bdps * qp->m_win) return line;
+    uint64_t active = 1;
+    for (uint32_t i = 0; i < group->GetN(); ++i) {
+        Ptr<RdmaQueuePair> other = group->Get(i);
+        if (other == qp || (same_peer_only && other->dip != qp->dip) ||
+            other->IsFinishedConst() || other->GetBytesLeft() == 0 ||
+            other->m_win == 0 || other->m_size <= minimum_bdps * other->m_win) continue;
+        ++active;
+    }
+    return std::min(line, std::max(minimum_rate_bps, line / active));
+}
