+static unsigned fired = 0;
+static void Fire() { ++fired; }
+int main() {
+    auto q=CreateObject<RdmaQueuePair>(3,Ipv4Address(1),Ipv4Address(2),100,101);
+    q->SetSize(100000);q->snd_nxt=q->snd_una=1000;
+    q->m_retransmit=Simulator::Schedule(NanoSeconds(10),&Fire);
+    assert(!q->IsFinished());
+    assert(RdmaHw::CancelGuardIdleRetransmit(q));
+    assert(!RdmaHw::CancelGuardIdleRetransmit(q));
+    q->snd_nxt=2000;
+    q->m_retransmit=Simulator::Schedule(NanoSeconds(20),&Fire);
