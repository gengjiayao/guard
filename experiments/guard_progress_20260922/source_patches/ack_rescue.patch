+    const int64_t rto = qp->GetRto(mtu).GetNanoSeconds();
+    const int64_t left = Simulator::GetDelayLeft(qp->m_retransmit).GetNanoSeconds();
+    return rto > 0 && left > 0 && left <= rto / 2;
