+}
diff --git a/tests/guard_recovery_increment.cc b/tests/guard_recovery_increment.cc
new file mode 100644
index 0000000..9f73c8d
--- /dev/null
+++ b/tests/guard_recovery_increment.cc
@@ -0,0 +1,30 @@
+#include "ns3/rdma-hw.h"
+#include <cassert>
+#include <cstdint>
+#include <limits>
+#include <random>
+#include <iostream>
+using namespace ns3;
+int main() {
+    const uint64_t base=40000000, rtt=8320;
+    auto f=[](uint64_t a,uint64_t d,uint64_t r,uint32_t n){return RdmaHw::ComputeGuardRecoveryIncrementBps(a,d,r,n);};
+    assert(f(base,0,rtt,8)==base);
+    assert(f(base,rtt/2,rtt,8)==base);
+    assert(f(base,rtt*3/2,rtt,8)==60000000);
+    assert(f(base,rtt*64,rtt,8)==base*8);
+    assert(f(base,rtt*64,rtt,0)==base);
+    assert(f(base,rtt*64,rtt,1)==base);
+    assert(f(base,rtt*64,0,8)==base);
+    assert(f(0,rtt*64,rtt,8)==0);
+    uint64_t big=std::numeric_limits<uint64_t>::max();
+    assert(f(big,big,1,64)==big);
+    std::mt19937_64 rng(4721);
+    for (unsigned i=0;i<10000;++i) {
+        uint64_t a=rng()%100000000001ULL,r=1+rng()%1000000,d=rng()%100000000;
+        uint32_t n=2+rng()%63;
+        uint64_t x=f(a,d,r,n),y=f(a,d+1,r,n);
+        assert(x>=a && x<=a*n && y>=x);
+        assert(f(a,d,r,0)==a);
+    }
+    std::cout<<"PASS: recovery scaling, no elapsed-time credit below one RTT, disabled/zero RTT, saturation, 10000 monotonic bounded states\n";
+}
diff --git a/tests/guard_scheduling_horizon.cc b/tests/guard_scheduling_horizon.cc
new file mode 100644
index 0000000..bfeb37e
--- /dev/null
+++ b/tests/guard_scheduling_horizon.cc
@@ -0,0 +1,138 @@
+// Behavioral checks against the actual receiver allocator, not a model copy.
+#include "ns3/rdma-hw.h"
+#include <algorithm>
+#include <cassert>
+#include <iostream>
+#include <random>
+
+using namespace ns3;
+
+int main() {
+    Ptr<RdmaHw> hw = CreateObject<RdmaHw>();
+    const uint64_t capacity = 100000000000ULL;
+    const uint64_t bdp = 100000;
+    hw->m_guardReceiverConcurrency = 1;
+    hw->m_guardConcurrencyMinBdps = 1;
+    hw->m_guardSchedulingHorizonBdps = 128;
+    hw->m_guardMinShareFraction = .25;
+    hw->m_guardAdaptiveElephantConcurrency = false;
+    hw->m_guardSizeClassElephantConcurrency = false;
+    hw->m_guardRemainingAware = true;
+    hw->m_guardRemainingExponent = 1;
+    hw->m_mtu = 1000;
+    hw->m_minRate = DataRate(100000000);
+    std::mt19937 rng(7249);
+    std::vector<Ptr<RdmaRxQueuePair> > flows;
+    for (unsigned trial = 0; trial < 1000; ++trial) {
+        hw->m_rate_flow_ctl_set.clear();
+        flows.clear();
+        unsigned count = 2 + rng() % 30;
+        for (unsigned i = 0; i < count; ++i) {
+            Ptr<RdmaRxQueuePair> f = Create<RdmaRxQueuePair>();
+            f->m_base_rtt_sec = .000008;
+            f->dip = trial % 2 ? i + 1 : 1;
+            f->m_flow_id = i;
+            f->m_guard_flow_size = (2 + rng() % 2000) * bdp;
+            f->ReceiverNextExpectedSeq = rng() % f->m_guard_flow_size;
+            flows.push_back(f);
+            hw->m_rate_flow_ctl_set.insert(PeekPointer(f));
+        }
+        hw->m_guardMinShareFraction = (trial % 5) * .25;
+        auto targets = hw->ComputeGuardBaseTargets(capacity);
+        uint64_t sum = 0;
+        uint64_t floor = hw->m_guardMinShareFraction * (capacity / count);
+        for (auto &entry : targets) {
+            assert(entry.second >= floor);
+            sum += entry.second;
+        }
+        assert(sum <= capacity);
+        assert(capacity - sum <= count);
+        std::reverse(flows.begin(), flows.end());
+        hw->m_rate_flow_ctl_set.clear();
+        for (auto f : flows) hw->m_rate_flow_ctl_set.insert(PeekPointer(f));
+        auto reversed = hw->ComputeGuardBaseTargets(capacity);
+        for (auto &entry : targets) {
+            // Floating-point summation may move a rounded target by one bit/s.
+            assert(std::abs((int64_t)entry.second - (int64_t)reversed[entry.first]) <= 1);
+        }
+    }
+    // Equal long flows remain equal despite very different attained service.
+    hw->m_guardMinShareFraction = 0;
+    for (unsigned i = 0; i < flows.size(); ++i) {
+        flows[i]->dip = i + 1;
+        flows[i]->m_guard_flow_size = 2000 * bdp;
+        flows[i]->ReceiverNextExpectedSeq = i * bdp;
+    }
+    auto equal = hw->ComputeGuardBaseTargets(capacity);
+    for (auto &entry : equal) assert(entry.second == capacity / flows.size());
+    // A single NIC keeps its remaining-size scheduler for long messages.
+    for (auto f : flows) f->dip = 1;
+    auto single = hw->ComputeGuardBaseTargets(capacity);
+    hw->m_guardSchedulingHorizonBdps = 0;
+    auto legacy = hw->ComputeGuardBaseTargets(capacity);
+    for (auto &entry : single) assert(entry.second == legacy[entry.first]);
+    // Opt-in ordering concentrates a single NIC's long-message grant on its
+    // smallest remaining message, while other sources still share fairly.
+    hw->m_guardSingleSenderOrder = true;
+    auto ordered = hw->ComputeGuardBaseTargets(capacity);
+    auto shortest = *std::min_element(flows.begin(), flows.end(),
+        [](Ptr<RdmaRxQueuePair> a, Ptr<RdmaRxQueuePair> b) {
+            return a->m_guard_flow_size - a->ReceiverNextExpectedSeq <
+                   b->m_guard_flow_size - b->ReceiverNextExpectedSeq;
+        });
+    assert(ordered[PeekPointer(shortest)] > .95 * capacity);
+    hw->m_guardSchedulingHorizonBdps = 128;
+    for (unsigned i = 0; i < flows.size(); ++i) flows[i]->dip = i + 1;
+    auto still_equal = hw->ComputeGuardBaseTargets(capacity);
+    for (auto &entry : still_equal) assert(entry.second == capacity / flows.size());
+    hw->m_guardSingleSenderOrder = false;
+    // The shared-cap experiment uses one physical NIC budget, not the sum
+    // of its alternative per-message caps. It must close on a second sender
+    // or a mixed short/long cohort.
+    hw->m_guardSingleSenderSharedCapBdps = 128;
+    for (auto f : flows) f->dip = 1;
+    auto shared = hw->ComputeGuardBaseTargets(capacity);
+    for (auto &entry : shared) assert(entry.second == capacity);
+    assert(!hw->GuardHasCompetingSenders(capacity));
+    hw->m_guardSingleSenderSharedSlots = 2;
+    auto slotted = hw->ComputeGuardBaseTargets(capacity);
+    unsigned selected = 0;
+    for (auto &entry : slotted) {
+        if (entry.second == capacity) ++selected;
+        else assert(entry.second == hw->m_minRate.GetBitRate());
+    }
+    assert(selected == std::min<size_t>(2, flows.size()));
+    hw->m_guardSingleSenderSharedSlots = 0;
+    flows[0]->dip = 2;
+    auto multiple = hw->ComputeGuardBaseTargets(capacity);
+    uint64_t total = 0;
+    for (auto &entry : multiple) total += entry.second;
+    assert(total <= capacity);
+    flows[0]->dip = 1;
+    flows[0]->m_guard_flow_size = 2 * bdp;
+    flows[0]->ReceiverNextExpectedSeq = 0;
+    assert(!hw->UsesGuardSingleSenderSharedCap(capacity));
+    hw->m_guardSingleSenderSharedCapBdps = 0;
+    hw->m_guardSchedulingHorizonBdps = 128;
+    hw->m_guardConcurrencyMinBdps = 12;
+    hw->m_rate_flow_ctl_set.clear();
+    flows.resize(2);
+    for (unsigned i = 0; i < 2; ++i) {
+        flows[i]->dip = i + 1;
+        flows[i]->m_guard_flow_size = (6 + 2*i) * 1048576;
+        flows[i]->ReceiverNextExpectedSeq = 0;
+        flows[i]->m_base_rtt_sec = i ? .000008 : .000002;
+        hw->m_rate_flow_ctl_set.insert(PeekPointer(flows[i]));
+    }
+    auto different_paths = hw->ComputeGuardBaseTargets(capacity);
+    assert(different_paths[PeekPointer(flows[0])] > .99 * capacity);
+    // Mixing a short class into receiver fan-in restores weighted service.
+    flows[0]->m_guard_flow_size = 200000;
+    auto mixed = hw->ComputeGuardBaseTargets(capacity);
+    hw->m_guardReceiverConcurrency = 0;
+    auto weighted = hw->ComputeGuardBaseTargets(capacity);
+    for (auto &entry : mixed) assert(entry.second == weighted[entry.first]);
+    hw->m_rate_flow_ctl_set.clear();
+    Simulator::Destroy();
+    std::cout << "PASS: 1000 allocator states; capacity, floor, order, equality, sender scope, mixed classes, unequal RTTs\n";
+}
